# ------------------------------------------------------------------
# Copy this file to ".env" and fill in REAL values:   cp .env.example .env
# NEVER commit the real .env — it's already in .dockerignore and should
# also be in your .gitignore. This is the Q2 "secrets management" point.
# ------------------------------------------------------------------

# --- Database ---
# LOCAL:      leave this as-is. docker-compose.yml overrides it to point at
#             the local Postgres container automatically.
# PRODUCTION: do NOT put the Neon URL here. Set it on Fly with:
#                 fly secrets set DATABASE_URL="postgresql://...neon.tech/..."
DATABASE_URL=postgresql://sahayak:sahayak@db:5432/sahayak

# --- LLM provider ---
OPENAI_API_KEY=sk-replace-me

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- App ---
PORT=8000
